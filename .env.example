# Security
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Database — uses SQLite by default; switch to PostgreSQL in production
DATABASE_URL=sqlite+aiosqlite:///./chirp.db
# DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/nextweet

# CORS — comma-separated origins allowed
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Frontend URL (used for password reset links)
FRONTEND_URL=http://localhost:5173

# Email (SMTP) — required for password reset in production
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=
# EMAIL_FROM=noreply@nextweet.app
